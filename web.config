<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Enable static content compression -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="9" />
      <staticTypes>
        <add mimeType="text/html" enabled="true" />
        <add mimeType="text/css" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="image/webp" enabled="true" />
      </staticTypes>
    </httpCompression>

    <!-- Static file cache -->
    <staticContent>
      <!-- Images - 30 days cache -->
      <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <mimeMap fileExtension=".gif" mimeType="image/gif" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      
      <!-- Client cache policy -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>

    <!-- Cache-Control headers per file type -->
    <httpProtocol>
      <customHeaders>
        <!-- General cache policy -->
        <add name="Cache-Control" value="public, max-age=86400" />
      </customHeaders>
    </httpProtocol>

    <!-- URL Rewrite rules for cache headers (if URL Rewrite is installed) -->
    <rewrite>
      <rules>
        <!-- Images - 30 days -->
        <rule name="CacheImages" stopProcessing="true">
          <match url="\.(jpg|jpeg|png|gif|webp|ico)$" />
          <action type="None" />
          <outboundRules>
            <outboundRule name="SetImageCache" stopProcessing="true">
              <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
              <action type="Rewrite" value="public, max-age=2592000, immutable" />
            </outboundRule>
          </outboundRules>
        </rule>
        <!-- CSS/JS - 14 days -->
        <rule name="CacheStaticAssets" stopProcessing="true">
          <match url="\.(css|js)$" />
          <action type="None" />
          <outboundRules>
            <outboundRule name="SetStaticCache" stopProcessing="true">
              <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
              <action type="Rewrite" value="public, max-age=1209600" />
            </outboundRule>
          </outboundRules>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
